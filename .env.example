# ---- Firebase (required) ----
# Web client config for Google sign-in + Realtime Database. These identify the
# public project; database.rules.json enforces per-user access.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-side REST access and ID-token verification (same project).
FIREBASE_API_KEY=
FIREBASE_DATABASE_URL=

# ---- GEO scan providers (add at least one; all four for full coverage) ----
# ChatGPT: https://platform.openai.com/api-keys
OPENAI_API_KEY=
GEO_OPENAI_MODEL=gpt-4.1-mini
# Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
GEO_ANTHROPIC_MODEL=claude-sonnet-4-5
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEO_GEMINI_MODEL=gemini-2.5-flash
# Perplexity: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
GEO_PERPLEXITY_MODEL=sonar

# ---- Scheduled daily scans (optional) ----
# Vercel cron calls /api/geo/cron daily at 03:00 UTC (see vercel.json).
CRON_SECRET=
# Service account from the same Firebase project (Project settings -> Service
# accounts). Enables the cron route to scan every workspace.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ---- Rate limiting (optional but recommended) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Demo mode (local development only; never enable in production) ----
# Enables the "demo-token" developer identity with an in-memory store that
# never calls paid providers.
ENABLE_DEMO_MODE=false

APP_BASE_URL=https://gothreadly.live
NEXT_PUBLIC_APP_URL=https://www.gothreadly.live
