# Threadly environment variables.
# Copy to .env.local for local development. In production, set these in the
# hosting provider's encrypted environment settings, never in the repository.
# Every variable below is read by the code; anything not listed is unused.

# ---- Firebase (required) ----
# Web client config for Google sign-in and the Realtime Database. These
# identify the public project; database.rules.json enforces per-user access.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-side REST access and ID-token verification (same project).
FIREBASE_API_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=

# Service account from the same Firebase project (Project settings ->
# Service accounts). Needed for scheduled scans, team workspaces, billing
# webhooks and the outbound stores. Keep the private key's \n escapes.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ---- Site ----
NEXT_PUBLIC_APP_URL=https://www.gothreadly.live
NEXT_PUBLIC_SITE_URL=https://www.gothreadly.live

# ---- GEO scan providers (add at least one) ----
# Scans run on ChatGPT, Claude and Gemini. A provider without a key is shown
# as "not configured" and is never reported as scanned.
OPENAI_API_KEY=
GEO_OPENAI_MODEL=gpt-4.1-mini
# Model for question suggestions (falls back to gpt-4.1-mini).
OPENAI_MODEL=
ANTHROPIC_API_KEY=
GEO_ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEO_GEMINI_MODEL=gemini-3.8-flash
# Legacy alias for GEO_GEMINI_MODEL.
GEMINI_MODEL=
# Organic web results and social search (optional).
TAVILY_API_KEY=

# Encrypts bring-your-own provider keys at rest (AES-256-GCM). Any long
# random string; generate with: openssl rand -hex 32. Without it, workspaces
# cannot save their own keys.
KEY_ENCRYPTION_SECRET=

# ---- Scheduled scans ----
# Vercel cron calls /api/geo/cron daily at 03:00 UTC (see vercel.json) with
# this bearer secret. Requires the FIREBASE_ADMIN_* service account.
CRON_SECRET=

# ---- Rate limiting (recommended in production) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Help assistant ----
# Uses ANTHROPIC_API_KEY. Spend is capped per month; past the cap the
# assistant answers from documentation only.
ASSISTANT_MODEL=claude-haiku-5-5
ASSISTANT_MONTHLY_CAP_USD=10

# ---- Transactional email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM=Threadly <hello@gothreadly.live>

# ---- Billing ----
# Dodo Payments (primary outside India). DODO_PAYMENTS_ENVIRONMENT must be
# exactly "live_mode" for live charges; anything else is test mode.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Razorpay (primary for India). The key prefix (rzp_test_ / rzp_live_) sets
# the mode; live checkout additionally needs RAZORPAY_LIVE_ENABLED=true.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_LIVE_ENABLED=false
# Comma-separated emails allowed to use test-mode checkout on a live site.
BILLING_TEST_EMAILS=
# Comma-separated emails exempt from the paid-trial requirement.
TRIAL_EXEMPT_EMAILS=
# Promotion code that waives the trial fee. Leave empty to disable.
TRIAL_PROMO_CODE=

# ---- Prospecting ----
# Web search for competitors and companies uses TAVILY_API_KEY (above).
# Optional renderer for JavaScript-heavy sites (hosted Firecrawl API). Our own
# robots.txt check still applies first.
FIRECRAWL_API_KEY=
# Licensed contact data for the decision-maker step. Absent = no contacts are
# looked up; Threadly never scrapes social networks or guesses addresses.
HUNTER_API_KEY=
# Model-written summaries, campaigns, emails and social replies. On when
# ANTHROPIC_API_KEY is set; "false" turns it off. Spend is capped per month
# (calls are refused at the cap and drafts fall back to composed text).
PROSPECTING_MODEL_ENABLED=
PROSPECTING_MODEL=claude-haiku-5-5
PROSPECTING_MONTHLY_CAP_USD=10

# ---- Public live demo (landing page) ----
# Real web searches for anonymous visitors, counted in the Realtime Database
# per day. In production the demo refuses to run if the counter is
# unavailable. Uses TAVILY_API_KEY; never calls the contact provider.
PUBLIC_DEMO_RUNS_PER_VISITOR=3
PUBLIC_DEMO_DAILY_RUNS=150

# ---- Product analytics (PostHog, consent-gated) ----
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Enterprise outbound (dark by default) ----
# Every outbound route returns 404 unless OUTBOUND_ENABLED=true AND an
# explicit OUTBOUND_DATA_ROOT is set ("outbound-test" for preview, "outbound"
# for a deliberate production rollout). A stray flag alone keeps it dark.
OUTBOUND_ENABLED=
OUTBOUND_DATA_ROOT=
# Owner-only posture: when true, OUTBOUND_ALLOWED_UIDS (comma-separated
# Firebase uids) must be set, or every user is denied.
OUTBOUND_OWNER_ONLY=true
OUTBOUND_ALLOWED_UIDS=
# Real provider sends stay off unless this is exactly "true".
OUTBOUND_PROVIDERS_LIVE=
# Public origin used in unsubscribe and booking links.
OUTBOUND_PUBLIC_BASE_URL=
# HMAC key for one-click unsubscribe links. To rotate, move the old value to
# OUTBOUND_UNSUBSCRIBE_SECRET_PREVIOUS so links already sent keep working.
OUTBOUND_UNSUBSCRIBE_SECRET=
OUTBOUND_UNSUBSCRIBE_SECRET_PREVIOUS=
# HMAC key for OAuth consent state (16+ characters).
OUTBOUND_OAUTH_STATE_KEY=
# AES-256-GCM key for stored OAuth tokens: exactly 64 hex characters
# (openssl rand -hex 32). Without it, consent refuses to store tokens.
OUTBOUND_TOKEN_KEY=
# Google Workspace sender and calendar (OAuth client).
OUTBOUND_GMAIL_CLIENT_ID=
OUTBOUND_GMAIL_CLIENT_SECRET=
OUTBOUND_GMAIL_REDIRECT_URI=
# Shared token on the Gmail Pub/Sub push endpoint URL.
OUTBOUND_GMAIL_WEBHOOK_TOKEN=
# Microsoft 365 sender and calendar (OAuth client).
OUTBOUND_MS_CLIENT_ID=
OUTBOUND_MS_CLIENT_SECRET=
OUTBOUND_MS_REDIRECT_URI=
# clientState secret for Microsoft Graph change notifications.
OUTBOUND_MICROSOFT_WEBHOOK_SECRET=
# HubSpot private-app token for CRM sync (absent = sync refuses).
OUTBOUND_HUBSPOT_TOKEN=
# Model endpoint for assisted personalisation (absent = deterministic
# templates only). Usage from a real model is recorded at unknown cost,
# which blocks dispatch until pricing is configured.
OUTBOUND_LLM_BASE_URL=
OUTBOUND_LLM_API_KEY=
OUTBOUND_LLM_MODEL=

# ---- Local development only (never set in production) ----
# Enables the "demo-token" developer identity with an in-memory store that
# never calls paid providers.
ENABLE_DEMO_MODE=false
# Points the server at a local Realtime Database emulator (tests only).
FIREBASE_DATABASE_EMULATOR_HOST=
# Alternate build output directory.
NEXT_DIST_DIR=
