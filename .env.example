# Firebase web app configuration for Google sign-in and Realtime Database.
# These Firebase client values identify the app; database.rules.json protects user data.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBh_cw7QS00FX2ZwaGtNnuiNhXaVWbdYWM
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=wisentry-510811.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://wisentry-510811-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=wisentry-510811
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=wisentry-510811.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=440715891811
NEXT_PUBLIC_FIREBASE_APP_ID=1:440715891811:web:c9621931ac20513a8c5456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-L48YZPBZ7B

# Server-side Firebase REST access and ID-token verification.
FIREBASE_API_KEY=AIzaSyBh_cw7QS00FX2ZwaGtNnuiNhXaVWbdYWM
FIREBASE_DATABASE_URL=https://wisentry-510811-default-rtdb.firebaseio.com

# Optional shared limiter for anonymous public endpoints. Authenticated
# endpoints use atomic per-user counters in Firebase Realtime Database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional text-generation providers. These write website summaries, content,
# and email drafts; Laya and AnyJev are decision models and handle qualification.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional live GEO scans. Each scan calls every configured provider above.
GEO_BRAND_DOMAIN=gothreadly.live
GEO_OPENAI_MODEL=gpt-4.1-mini
GEO_GEMINI_MODEL=gemini-2.5-flash

# Optional typed-decision model services for automatic prospect qualification.
# Run Laya with laya-serve and AnyJev's Tacit HTTP gateway (or a compatible proxy).
# Keep these endpoints private to the Wisentry server; AnyJev's built-in gateway
# does not authenticate requests by itself.
LAYA_URL=
LAYA_API_KEY=
ANYJEV_URL=
ANYJEV_API_KEY=

# Optional: enables reviewed, one-at-a-time email delivery through Amazon SES.
USE_AWS=false
AWS_REGION=us-east-1
FROM_EMAIL=
REPLY_TO_EMAIL=

# Transactional beta emails through Resend. Verify gothreadly.live in Resend,
# then copy its API key and use a sender on that domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Threadly <beta@gothreadly.live>
RESEND_REPLY_TO=kiran160703kumar@gmail.com
APP_BASE_URL=https://gothreadly.live

# Configure one server-side provider to enable live X discovery.
APIFY_TOKEN=
# Optional fallback if you have X API recent-search access.
X_BEARER_TOKEN=
