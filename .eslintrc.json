{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "env": { "browser": true, "node": true, "es2022": true },
  "plugins": ["react-hooks"],
  "extends": ["eslint:recommended", "plugin:react-hooks/recommended"],
  "rules": {
    "no-undef": "off",
    "no-unused-vars": "off"
  }
}
