{
  "name": "threadly",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ext .js,.mjs,.ts,.tsx src next.config.mjs postcss.config.mjs tailwind.config.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs unit",
    "test:emulator": "npx --yes firebase-tools@15.34.2 emulators:exec --config tests/emulator/firebase.json --only database --project demo-threadly \"node scripts/run-tests.mjs emulator\"",
    "test:all": "node scripts/run-tests.mjs all",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@vercel/analytics": "^2.0.1",
    "dodopayments": "^2.57.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.55.0",
    "next": "^15.5.28",
    "posthog-js": "^1.439.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "braces": "^3.0.3",
    "postcss": "^8.5.30",
    "postcss-selector-parser": "^7.1.6"
  },
  "description": "Threadly: enterprise prospecting and outreach with GEO intelligence (brand mention and citation-share monitoring across ChatGPT, Claude and Gemini)."
}
